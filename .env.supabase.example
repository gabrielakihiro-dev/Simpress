# Documentation only: the application does not load dotenv files.
# Set process environment variables in PowerShell before starting main.py.
SIMPRESS_PERSISTENCE_BACKEND=files
# PostgreSQL is an explicit disposable local pilot until stages 6-8.
SIMPRESS_POSTGRES_LOCAL_PILOT=0
SIMPRESS_DATABASE_URL=postgresql://simpress_piloto_login:EXAMPLE_ONLY@127.0.0.1:54322/postgres
SIMPRESS_DATABASE_POOL_SIZE=4
