# Documentation only: the application does not load dotenv files.
# Set process environment variables in PowerShell before starting main.py.
SIMPRESS_PERSISTENCE_BACKEND=files
# PostgreSQL is an explicit disposable local pilot until stages 6-8.
SIMPRESS_POSTGRES_LOCAL_PILOT=0
SIMPRESS_DATABASE_URL=postgresql://simpress_piloto_login:EXAMPLE_ONLY@127.0.0.1:54322/postgres
SIMPRESS_DATABASE_POOL_SIZE=4
# Optional, server-only. Prefer scripts/run_postgres_pilot.py --storage,
# which reads the key from the checked local CLI in memory.
SIMPRESS_STORAGE_SERVICE_KEY=
# Stage 7: use scripts/run_postgres_pilot.py --auth to populate these in memory.
# Requires simpress_runtime_login instead of simpress_piloto_login when enabled.
SIMPRESS_AUTH_ENABLED=0
SIMPRESS_APP_ORIGIN=http://127.0.0.1:8000
SIMPRESS_AUTH_API_KEY=
SIMPRESS_SESSION_KEY=
SIMPRESS_COOKIE_SECURE=0
SIMPRESS_PROXY_HEADERS=0
SIMPRESS_CORS_ORIGINS=
