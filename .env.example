# Copie para .env (fora do Git) e preencha. Nunca coloque a chave real neste arquivo.
OPENROUTER_API_KEY=
# Alternativa: API direta do DeepSeek. Se preenchida, vale no lugar do OpenRouter
# (sem fallback e sem data_collection: deny). A mensagem de voz continua pelo OpenRouter
# se OPENROUTER_API_KEY também estiver preenchida; sem ela, a voz fica indisponível.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Opcionais (valores padrão abaixo):
# MODELO_PRINCIPAL=google/gemini-2.5-flash-lite
# MODELO_FALLBACK=openai/gpt-4o-mini
# Modelo que transcreve as mensagens de voz (precisa aceitar áudio):
# MODELO_AUDIO=google/gemini-2.5-flash
# ROUTING_SORT=throughput
